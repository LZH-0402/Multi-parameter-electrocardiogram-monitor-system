{
  "doc_type": "技术项目书（嵌入式软硬件项目总结报告）",
  "style_family": "engineering-report",
  "palette": {
    "ink": "#1a1d21",
    "ink_soft": "#4a5158",
    "ink_faint": "#7a838c",
    "rule": "#dfe3e8",
    "rule_soft": "#eef1f4",
    "paper": "#ffffff",
    "paper_alt": "#f7f9fb",
    "accent": "#1565c0",
    "accent_soft": "#e8f1fb",
    "accent_deep": "#0d3f7a",
    "warn": "#b1560f",
    "warn_soft": "#fdf3e7",
    "ok": "#1b7a4b",
    "code_bg": "#f4f6f8",
    "code_ink": "#24303a"
  },
  "typography": {
    "h1": "24pt / bold / letter-spacing 0.5px",
    "h2": "17pt / bold / 左侧 4px accent 竖线 + 下边框",
    "h3": "13pt / bold / accent_deep",
    "h4": "11.5pt / bold / ink",
    "body": "10.5pt / 1.85 / ink",
    "table": "9.5pt / 1.5",
    "code": "9pt / Consolas, 'Courier New' / 1.6",
    "caption": "9pt / ink_faint"
  },
  "layout": {
    "page": "A4",
    "margin": "22mm 20mm 20mm 20mm",
    "cover": "标题页居中，含副标题/元信息表/摘要卡",
    "table_style": "整表无竖线，仅表头底色 + 行分隔细线（三线表变体）",
    "callout": "左侧 3px 竖条 + 浅底，用于「易错点」「根因」提示"
  },
  "print": {
    "page_break_before_h2": true,
    "avoid_break_inside": "table, pre, .callout, .card"
  }
}
